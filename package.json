{
  "name": "agentest",
  "version": "0.1.1",
  "description": "AI-driven mobile app testing via MCP — any AI agent can test any Android app",
  "type": "module",
  "main": "dist/server.js",
  "bin": {
    "agentest": "dist/server.js"
  },
  "keywords": [
    "mcp",
    "testing",
    "android",
    "mobile",
    "ai",
    "automation",
    "accessibility",
    "adb",
    "emulator",
    "react-native",
    "flutter"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/arjun-vegeta/agenTest.git"
  },
  "homepage": "https://github.com/arjun-vegeta/agenTest",
  "bugs": {
    "url": "https://github.com/arjun-vegeta/agenTest/issues"
  },
  "author": "AgenTest",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write 'src/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts'",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist/**/*",
    "!dist/__tests__/**",
    "android-helper/prebuilt/agentest-helper.apk",
    "android-helper/prebuilt/agentest-helper-test.apk",
    "android-helper/prebuilt/agentest-idling-bridge.aar"
  ],
  "dependencies": {
    "@grpc/grpc-js": "^1.14.3",
    "@grpc/proto-loader": "^0.8.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "fast-xml-parser": "^5.2.0",
    "ws": "^8.20.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@types/node": "^22.14.0",
    "@types/ws": "^8.18.1",
    "eslint": "^9.25.0",
    "eslint-config-prettier": "^10.1.0",
    "prettier": "^3.5.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.30.0",
    "vitest": "^3.1.0"
  },
  "license": "MIT"
}
